#!/usr/bin/env python3
"""ck-bondcheck: is the whole Mac leaving through Frankfurt, bonded, with nothing leaking? (14.11.2026)

Marko, 14.11.2026: "my whole machine now running on frankfurt ip that is fine, build that test".

    ck-bondcheck            the checks, one line each, then PASS or FAIL (exit 0 / 1)
    ck-bondcheck --speed    also one 10 MB download through the system (about 10 MB of SIM data)
    ck-bondcheck --json     the same as JSON

Checks: bond switched on (bond.json); the aggregate's bond has two or more live legs and is not stepping aside; the
public IPv4 seen from outside is the relay's address; Cloudflare places the Mac in Frankfurt (colo FRA); no IPv6 path
around the bond (an IPv6 address would leak the home line); the relay's port 443 answers; on the VM the CKBOND service
runs (through vmctl, when it is installed). Never prints the token.
"""
import json, os, shutil, socket, subprocess, sys, time, urllib.request

SUPPORT = os.path.expanduser("~/Library/Application Support/connection-keeper")
STATUS = "http://127.0.0.1:8857/status"
TEN_MB = "https://proof.ovh.net/files/10Mb.dat"     # 10 485 760 bytes (checked: content-length)


def get(url, timeout=8):
    req = urllib.request.Request(url, headers={"User-Agent": "ck-bondcheck"})
    with urllib.request.urlopen(req, timeout=timeout) as r:
        return r.read().decode("utf-8", "replace")


def run(cmd, timeout=20):
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
        return r.returncode, (r.stdout + r.stderr).strip()
    except Exception as e:
        return 1, str(e)


def main(argv):
    rows, server = [], None

    def check(name, ok, detail):
        rows.append({"check": name, "ok": bool(ok), "detail": detail})

    try:
        cfg = json.load(open(os.path.join(SUPPORT, "bond.json")))
        server = cfg.get("server")
        check("bond switched on", cfg.get("on") is True, f"relay {server}:{cfg.get('port')}")
    except Exception as e:
        check("bond switched on", False, f"no bond.json ({e})")

    try:
        b = json.loads(get(STATUS, 4)).get("bond") or {}
        legs = [l for l in b.get("legs", []) if l.get("alive")]
        names = ", ".join(f"{l['line']} {l.get('rttMs', '?')} ms" for l in legs) or "none"
        check("two or more live legs", len(legs) >= 2, names)
        check("bond in use (not stepping aside)", not b.get("bypass"), b.get("bypass") or "in use")
    except Exception as e:
        check("aggregate status", False, f"no answer on {STATUS} ({e})")

    try:
        ip4 = get("https://api.ipify.org").strip()
        check("public IPv4 = the relay", server is not None and ip4 == server, ip4)
    except Exception as e:
        check("public IPv4 = the relay", False, str(e))

    try:
        t = dict(l.split("=", 1) for l in get("https://www.cloudflare.com/cdn-cgi/trace").splitlines() if "=" in l)
        check("Cloudflare sees Frankfurt", t.get("colo") == "FRA", f"{t.get('ip')} colo {t.get('colo')} {t.get('loc')}")
    except Exception as e:
        check("Cloudflare sees Frankfurt", False, str(e))

    code, out = run(["curl", "-s", "-m", "6", "-6", "https://api64.ipify.org"], 10)
    check("no IPv6 leak", code != 0 or not out or out == server, "no IPv6 route" if code != 0 or not out else f"IPv6 out as {out}")

    if server:
        # out over a real line (the cable first, else Wi-Fi), not through the Mac's own tunnel, which answers locally
        for dev in ("en17", "en0"):
            code, out = run(["curl", "-s", "-m", "6", "--interface", dev, "-o", "/dev/null", "-w", "%{time_connect}",
                             f"telnet://{server}:443"], 10)
            try:
                ms = float(out) * 1000
            except ValueError:
                ms = 0
            if ms > 0:
                check("relay port 443 answers", True, f"{ms:.0f} ms over {dev}")
                break
        else:
            check("relay port 443 answers", False, "no answer over en17 or en0")

    vmctl = shutil.which("vmctl") or os.path.expanduser("~/.local/bin/vmctl")
    if os.path.exists(vmctl):
        code, out = run([vmctl, "list"], 20)
        line = next((l for l in out.splitlines() if " ckbond " in f" {l} "), "")
        check("VM: CKBOND service runs", "running" in line, " ".join(line.split()[1:4]) if line else "no answer from vmctl")

    if "--speed" in argv:
        code, out = run(["curl", "-s", "-m", "90", "-o", "/dev/null", "-w", "%{size_download} %{time_total}", TEN_MB], 100)
        try:
            size, secs = out.split(); mbps = int(size) * 8 / 1e6 / float(secs)
            check("10 MB through the bond", int(size) == 10485760, f"{float(secs):.2f} s = {mbps:.0f} Mbit/s")
        except Exception:
            check("10 MB through the bond", False, out[:80])

    ok = all(r["ok"] for r in rows)
    if "--json" in argv:
        print(json.dumps({"pass": ok, "checks": rows}, indent=1))
    else:
        for r in rows:
            print(f"{'OK  ' if r['ok'] else 'FAIL'}  {r['check']:<34} {r['detail']}")
        print("PASS: the whole Mac leaves through Frankfurt, bonded" if ok else "FAIL: see the lines above")
    return 0 if ok else 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
