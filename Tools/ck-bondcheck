#!/usr/bin/env python3
"""ck-bondcheck: is the whole Mac leaving through Frankfurt, bonded, with nothing leaking? (14.11.2026)

Marko, 14.11.2026: "my whole machine now running on frankfurt ip that is fine, build that test".

    ck-bondcheck            the checks, one line each, then PASS or FAIL (exit 0 / 1)
    ck-bondcheck --speed    also one 10 MB download through the system (about 10 MB of SIM data)
    ck-bondcheck --json     the same as JSON
    ck-bondcheck --clean-save   before opening the app: keep proxies, routes, service order, DNS, our processes
    ck-bondcheck --clean        after quitting it: the same as before? (PASS = identical; request 87)

Checks: bond switched on (bond.json); DNS without leaks (whoami.cloudflare via 1.1.1.1 = the relay; the system
resolver's question to Google not from the home line); the aggregate's bond has a live leg (one = private, no speed gain; a note) and is not stepping aside; the
public IPv4 seen from outside is the relay's address; Cloudflare places the Mac in Frankfurt (colo FRA); no IPv6 path
around the bond (an IPv6 address would leak the home line); the relay's port 443 answers; on the VM the CKBOND service
runs (through vmctl, when it is installed). Never prints the token.
"""
import json, os, shutil, socket, subprocess, sys, time, urllib.request

SUPPORT = os.path.expanduser("~/Library/Application Support/connection-keeper")
STATUS = "http://127.0.0.1:8857/status"
TEN_MB = "https://proof.ovh.net/files/10Mb.dat"     # 10 485 760 bytes (checked: content-length)


def get(url, timeout=8):
    req = urllib.request.Request(url, headers={"User-Agent": "ck-bondcheck"})
    with urllib.request.urlopen(req, timeout=timeout) as r:
        return r.read().decode("utf-8", "replace")


def run(cmd, timeout=20):
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
        return r.returncode, (r.stdout + r.stderr).strip()
    except Exception as e:
        return 1, str(e)


CLEAN = os.path.join(SUPPORT, "clean-before.json")


def clean_state():
    """What the app may change on the Mac and must give back at quit (request 87): the proxies, the default and half
    routes, the service order, the DNS resolvers, and our processes."""
    st = {}
    st["proxy"] = run(["scutil", "--proxy"])[1]
    routes = run(["netstat", "-rn", "-f", "inet"])[1].splitlines()
    st["routes"] = sorted(" ".join(l.split()[:2] + l.split()[3:4]) for l in routes
                          if l.split() and l.split()[0] in ("default", "0/1", "128.0/1") and "I" not in (l.split()[2] if len(l.split()) > 2 else ""))
    st["service order"] = [l for l in run(["networksetup", "-listnetworkserviceorder"])[1].splitlines() if l.startswith("(")]
    st["dns"] = sorted(set(l.strip() for l in run(["scutil", "--dns"])[1].splitlines() if "nameserver[" in l))
    ps = run(["ps", "-axo", "comm"])[1].splitlines()
    st["processes"] = sorted(set(os.path.basename(p) for p in ps if os.path.basename(p) in ("ck-aggregate", "connection-keeperd", "hev-socks5-tunnel")))
    st["tunnel flag"] = os.path.exists(os.path.join(SUPPORT, "tunnel-on"))
    return st


def clean(argv):
    """--clean-save: keep the state before opening the app. --clean: compare with it after quitting (PASS = identical)."""
    now = clean_state()
    if "--clean-save" in argv:
        json.dump(now, open(CLEAN, "w"), indent=1)
        print(f"saved the state before: {len(now['routes'])} default/half routes, {len(now['service order'])} services, "
              f"{len(now['dns'])} resolvers, processes {now['processes'] or 'none'}")
        return 0
    try:
        before = json.load(open(CLEAN))
    except Exception:
        print("FAIL: no saved state (run ck-bondcheck --clean-save before opening the app)")
        return 1
    ok = True
    for k in before:
        same = before[k] == now.get(k)
        ok &= same
        print(f"{'OK  ' if same else 'FAIL'}  {k:<14} " + ("as before" if same else f"before {before[k]!r} now {now.get(k)!r}"))
    print("PASS: the Mac is exactly as before the app" if ok else "FAIL: something of the app is left")
    return 0 if ok else 1


def main(argv):
    if "--clean" in argv or "--clean-save" in argv:
        return clean(argv)
    rows, server, notes = [], None, []

    def check(name, ok, detail):
        rows.append({"check": name, "ok": bool(ok), "detail": detail})

    try:
        cfg = json.load(open(os.path.join(SUPPORT, "bond.json")))
        server = cfg.get("server")
        check("bond switched on", cfg.get("on") is True, f"relay {server}:{cfg.get('port')}")
    except Exception as e:
        check("bond switched on", False, f"no bond.json ({e})")

    homes = set()
    try:
        full = json.loads(get(STATUS, 4))
        homes = {l.get("publicIP") for l in full.get("lines", []) if l.get("publicIP")}
        b = full.get("bond") or {}
        legs = [l for l in b.get("legs", []) if l.get("alive")]
        names = ", ".join(f"{l['line']} {l.get('rttMs', '?')} ms" for l in legs) or "none"
        # v79: one leg is enough for privacy (the bond as a VPN); two or more add speed (a note, not a failure)
        check("a live leg to the relay", len(legs) >= 1, names)
        if len(legs) == 1:
            notes.append("one line only: private through the relay, no speed gain (a second line adds it)")
        check("bond in use (not stepping aside)", not b.get("bypass"), b.get("bypass") or "in use")
    except Exception as e:
        check("aggregate status", False, f"no answer on {STATUS} ({e})")

    try:
        ip4 = get("https://api.ipify.org").strip()
        check("public IPv4 = the relay", server is not None and ip4 == server, ip4)
    except Exception as e:
        check("public IPv4 = the relay", False, str(e))

    try:
        t = dict(l.split("=", 1) for l in get("https://www.cloudflare.com/cdn-cgi/trace").splitlines() if "=" in l)
        check("Cloudflare sees Frankfurt", t.get("colo") == "FRA", f"{t.get('ip')} colo {t.get('colo')} {t.get('loc')}")
    except Exception as e:
        check("Cloudflare sees Frankfurt", False, str(e))

    # v75 (request 85 item 2): DNS without leaks. Cloudflare says who asked it (should be the relay); Google says which
    # resolver asked it for the system's own question (should not be the home line, nor its /24 as a client subnet).
    code, out = run(["dig", "+short", "+time=3", "+tries=1", "CH", "TXT", "whoami.cloudflare", "@1.1.1.1"], 10)
    who = out.strip().strip('"')
    check("DNS to 1.1.1.1 leaves as the relay", server is not None and who == server, who or "no answer")
    code, out = run(["dig", "+short", "+time=3", "+tries=1", "TXT", "o-o.myaddr.l.google.com"], 10)
    seen = [w.strip('"') for w in out.split() if w.strip('"')[:1].isdigit()]
    home24 = {".".join(h.split(".")[:3]) for h in homes}
    leak = [x for x in seen if x.split("/")[0] in homes or ".".join(x.split("/")[0].split(".")[:3]) in home24]
    check("system DNS does not show the home line", bool(seen) and not leak,
          ("leak: " + ", ".join(leak)) if leak else (("resolver " + ", ".join(seen)) if seen else "no answer"))

    code, out = run(["curl", "-s", "-m", "6", "-6", "https://api64.ipify.org"], 10)
    check("no IPv6 leak", code != 0 or not out or out == server, "no IPv6 route" if code != 0 or not out else f"IPv6 out as {out}")

    if server:
        # out over a real line (the cable first, else Wi-Fi), not through the Mac's own tunnel, which answers locally
        for dev in ("en17", "en0"):
            code, out = run(["curl", "-s", "-m", "6", "--interface", dev, "-o", "/dev/null", "-w", "%{time_connect}",
                             f"telnet://{server}:443"], 10)
            try:
                ms = float(out) * 1000
            except ValueError:
                ms = 0
            if ms > 0:
                check("relay port 443 answers", True, f"{ms:.0f} ms over {dev}")
                break
        else:
            check("relay port 443 answers", False, "no answer over en17 or en0")

    vmctl = shutil.which("vmctl") or os.path.expanduser("~/.local/bin/vmctl")
    if os.path.exists(vmctl):
        code, out = run([vmctl, "list"], 20)
        line = next((l for l in out.splitlines() if " ckbond " in f" {l} "), "")
        check("VM: CKBOND service runs", "running" in line, " ".join(line.split()[1:4]) if line else "no answer from vmctl")

    if "--speed" in argv:
        code, out = run(["curl", "-s", "-m", "90", "-o", "/dev/null", "-w", "%{size_download} %{time_total}", TEN_MB], 100)
        try:
            size, secs = out.split(); mbps = int(size) * 8 / 1e6 / float(secs)
            check("10 MB through the bond", int(size) == 10485760, f"{float(secs):.2f} s = {mbps:.0f} Mbit/s")
        except Exception:
            check("10 MB through the bond", False, out[:80])

    ok = all(r["ok"] for r in rows)
    if "--json" in argv:
        print(json.dumps({"pass": ok, "checks": rows, "notes": notes}, indent=1))
    else:
        for r in rows:
            print(f"{'OK  ' if r['ok'] else 'FAIL'}  {r['check']:<34} {r['detail']}")
        for n in notes:
            print(f"NOTE  {n}")
        print("PASS: the whole Mac leaves through Frankfurt, bonded" if ok else "FAIL: see the lines above")
    return 0 if ok else 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
