# ckbond v1 relay (Network Aggregate Connection Keeper, request 84/85): the far end of the Mac's bonded lines.
# Installed by Tools/bond/install.sh as /etc/systemd/system/ckbond.service on chromium-vm. The VM's own drop-ins
# (ckbond.service.d/: vmcore.slice, CPU/IO weight, OOM) are kept by install.sh.
# v71: Type=notify + `systemctl reload ckbond` = a zero-downtime upgrade: the binary on disk takes over the same
# listening socket, tells systemd its pid (MAINPID), and the old process drains its streams (GOAWAY to the Mac).
[Unit]
Description=ckbond relay (Connection Keeper bonding)
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
NotifyAccess=all
ExecStart=/usr/local/bin/ck-bond-server -listen :443 -token-file ${CREDENTIALS_DIRECTORY}/token
ExecReload=/bin/kill -HUP $MAINPID
LoadCredential=token:/etc/ckbond/token
DynamicUser=yes
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
LimitNOFILE=65536
Restart=always
RestartSec=2
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
